<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink_900">

    <com.zenxi.yogatimer.ui.AmbientBackgroundView
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="22dp"
        android:paddingTop="10dp"
        android:paddingRight="22dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:tag="hi"
                    android:text="@string/app_name"
                    android:textSize="21sp"
                    android:textStyle="normal" />

                <TextView
                    android:id="@+id/subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:letterSpacing="0.16"
                    android:tag="low"
                    android:text="@string/app_sub"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="设置"
                android:padding="10dp"
                android:src="@drawable/ic_sliders" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="230dp">

            <com.zenxi.yogatimer.ui.RingTimerView
                android:id="@+id/ring"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <HorizontalScrollView
            android:id="@+id/presetScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/presetRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="2dp"
                android:paddingTop="2dp"
                android:paddingRight="2dp"
                android:paddingBottom="2dp" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_marginTop="6dp">

            <LinearLayout
                android:id="@+id/idleControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnStart"
                    android:layout_width="196dp"
                    android:layout_height="62dp"
                    android:gravity="center"
                    android:letterSpacing="0.22"
                    android:text="开 始"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/runControls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/btnStop"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:contentDescription="结束"
                    android:padding="18dp"
                    android:src="@drawable/ic_stop" />

                <Space
                    android:layout_width="20dp"
                    android:layout_height="1dp" />

                <ImageView
                    android:id="@+id/btnPause"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:contentDescription="暂停"
                    android:padding="26dp"
                    android:src="@drawable/ic_pause" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/quickRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/statsLine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:padding="6dp"
            android:tag="low"
            android:textSize="12sp" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/finishOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <View
            android:id="@+id/finishScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <LinearLayout
            android:id="@+id/finishCard"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="26dp"
            android:paddingTop="30dp"
            android:paddingRight="26dp"
            android:paddingBottom="26dp">

            <ImageView
                android:id="@+id/finishIcon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:src="@drawable/ic_check" />

            <TextView
                android:id="@+id/finishTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="0.1"
                android:tag="hi"
                android:text="练习完成"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/finishBig"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:tag="accent"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/finishSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:tag="mid"
                android:textSize="12.5sp" />

            <TextView
                android:id="@+id/btnFinishClose"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:letterSpacing="0.2"
                android:text="继 续"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>
